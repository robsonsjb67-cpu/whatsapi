# Token que protege a API
# Deixe vazio para gerar um automaticamente na primeira execução
API_TOKEN=

PORT=8080

# Banco: sqlite (padrão, arquivo em ./data) ou postgres
DB_DIALECT=sqlite
DB_URL=file:data/whatsapi.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
# DB_DIALECT=postgres
# DB_URL=postgres://usuario:senha@host:5432/whatsapi?sslmode=disable

# Se definido, cada webhook vai com o cabeçalho X-Signature-256 (HMAC-SHA256 do corpo)
WEBHOOK_SECRET=

# true = mídias recebidas vão em base64 dentro do webhook
WEBHOOK_MEDIA_BASE64=false

# DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Instância usada quando um sistema pede um nome que não existe (ex.: nome antigo da WaDuck).
# Vazio = usa a única instância conectada, se houver só uma.
FALLBACK_INSTANCE=
